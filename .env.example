# ─────────────────────────────────────────────────────────────────────────────
# TransformArte — Environment Variables
#
# Copy this file to .env.local and fill in every value before running locally.
# For Vercel production, set these in the project dashboard (Settings → Environment Variables).
#
# NEVER commit .env.local or any file that contains real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Prisma / Supabase PostgreSQL) ───────────────────────────────────
# Pooled connection string — used by the application at runtime (via PgBouncer).
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:6543/postgres?pgbouncer=true

# Direct (non-pooled) connection string — used by Prisma migrations and schema introspection.
# Must NOT go through PgBouncer; use port 5432.
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL — from Supabase dashboard → Settings → API → Project URL
SUPABASE_URL=https://[project-ref].supabase.co

# Service role key — grants admin access to all tables; NEVER expose to the browser.
# From Supabase dashboard → Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Name of the storage bucket used for file uploads.
SUPABASE_BUCKET=uploads

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret used to sign JWT session tokens.
# REQUIRED in production — the application will refuse to start without it.
# Must be at least 32 characters long.
# Generate a secure value with: openssl rand -hex 32
JWT_SECRET=

# Name of the HttpOnly session cookie.
COOKIE_NAME=ta_session

# ── File Uploads ──────────────────────────────────────────────────────────────
# Comma-separated list of accepted MIME types.
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Maximum file size in bytes (0 = no server-side size enforcement).
# Example: 10485760 = 10 MB
BODY_LIMIT_BYTES=10485760

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated list of origins that may call the API cross-origin.
# Leave blank to allow all origins (only acceptable behind a reverse proxy).
# Example: https://transform-arte.com.mx,https://www.transform-arte.com.mx
CORS_ALLOWED_ORIGINS=

# ── Geolocation (optional) ────────────────────────────────────────────────────
# Absolute path on the server to the MaxMind GeoLite2-City.mmdb file.
# If not set, visit records are stored without city/country enrichment.
# Download the free database: https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
GEOIP_MMDB_PATH=

# ── Monitoring ────────────────────────────────────────────────────────────────
# Sentry DSN for error tracking.
# From Sentry dashboard → Project Settings → Client Keys (DSN)
SENTRY_DSN=

# ── Next.js ───────────────────────────────────────────────────────────────────
# Public base URL of the deployment (used for metadata, OG tags, etc.).
NEXT_PUBLIC_BASE_URL=https://transform-arte.com.mx

# Runtime environment — Next.js sets this automatically; do not set manually in Vercel.
NODE_ENV=development
